{
  "name": "fumadocs-template",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run routes:build && next build",
    "dev": "npm run routes:build && next dev --turbo",
    "start": "next start",
    "postinstall": "fumadocs-mdx && npm run routes:build",
    "routes:build": "fumadocs-routes -o ./.source",
    "routes:check": "fumadocs-routes -o ./.source --strict",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "types:check": "npm run routes:check && fumadocs-mdx && next typegen && tsc --noEmit",
    "verify": "npm run lint && npm run types:check",
    "docker:webpack": "npm run routes:build && next dev --webpack",
    "docker:build": "IS_BUILD_DOCKER=1 npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "fumadocs-core": "16.17.3",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.3",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "takumi-js": "^2.15.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint-config-next": "^16.4.0",
    "eslint-plugin-import": "^2.32.0",
    "fumadocs-routes": "^1.1.7",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "5.0.3"
  }
}
